# Modèle de .env.local (versionné — AUCUNE valeur réelle ici).
# Copier en .env.local, qui est gitignoré.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement : inscription et mot de passe oublié (generateLink)
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings > Database — lu par scripts/db-migrate.js (Liquibase)
SUPABASE_DB_PASSWORD=
# Optionnels pour db-migrate.js : SUPABASE_DB_URL, SUPABASE_DB_USER, SUPABASE_POOLER_HOST

# ─── Application ─────────────────────────────────────────────────────────────
# Origine utilisée dans les liens des emails (confirmation, mot de passe, invitation)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email (SMTP Gmail, mêmes noms et mêmes identifiants que neighborshare) ──
# Sans ces deux variables, l'inscription retombe sur le mailer Supabase,
# qui ne livre qu'aux membres de l'équipe du projet.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── Keepalive (optionnel) ───────────────────────────────────────────────────
# Si défini, /api/keepalive exige `Authorization: Bearer <CRON_SECRET>`
# (le cron Vercel l'envoie seul ; l'ajouter aussi en secret du dépôt GitHub).
# CRON_SECRET=
