# Modèle de .env.local (versionné — AUCUNE valeur réelle ici).
# Copier en .env.local, qui est gitignoré.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Noms repris de neighborshare. Un projet créé depuis novembre 2025 n'a plus de
# clés anon / service_role : on y met ses nouvelles clés (Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Clé « publishable » : sb_publishable_…
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « secret » : sb_secret_… — serveur uniquement (inscription, mot de passe oublié)
SUPABASE_SERVICE_ROLE_KEY=
# Choisi à la création du projet (Settings > Database pour le réinitialiser).
# Lu par scripts/db-migrate.js (Liquibase), jamais par l'appli.
SUPABASE_DB_PASSWORD=
# Hôte du pooler « Transaction » (bouton Connect), ex. aws-1-eu-west-3.pooler.supabase.com
SUPABASE_POOLER_HOST=
# Optionnels pour db-migrate.js : SUPABASE_DB_URL, SUPABASE_DB_USER

# ─── Application ─────────────────────────────────────────────────────────────
# Origine utilisée dans les liens des emails (confirmation, mot de passe, invitation)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email (SMTP Gmail, mêmes noms et mêmes identifiants que neighborshare) ──
# Sans ces deux variables, l'inscription retombe sur le mailer Supabase,
# qui ne livre qu'aux membres de l'équipe du projet.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─── Crons : keepalive et rappels ────────────────────────────────────────────
# Obligatoire pour /api/rappels, optionnel pour /api/keepalive. Les crons Vercel
# envoient seuls `Authorization: Bearer <CRON_SECRET>`. Si la variable de dépôt
# KEEPALIVE_URL est renseignée sur GitHub, y mettre aussi ce secret : le
# workflow supabase-keepalive.yml en a besoin pour appeler /api/keepalive.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# ─── Rappels sur le téléphone (Web Push) ────────────────────────────────────
# Paire de clés VAPID, à générer une fois : npx web-push generate-vapid-keys
# Changer de paire oblige chaque appareil à réactiver ses rappels.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Serveur uniquement
VAPID_PRIVATE_KEY=
# Optionnel : contact donné aux services push (mailto: ou https:).
# Par défaut : mailto:GMAIL_USER.
# VAPID_SUBJECT=mailto:vous@exemple.fr
